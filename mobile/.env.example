# URL of the backend as seen by the APP (simulator / device / browser), not by a container.
#   iOS simulator, Expo Web ........ http://localhost:8000
#   Android emulator ............... http://10.0.2.2:8000
#   Physical device (same Wi-Fi) ... http://<your-LAN-IP>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_ROUTER_APP_ROOT=app

# --- docker compose only ---
# Host port for Metro.
MOBILE_PORT=8081
# REACT_NATIVE_PACKAGER_HOSTNAME is a per-machine Expo setting.
# Expo refuses it in .env — put it in .env.local instead:
#   REACT_NATIVE_PACKAGER_HOSTNAME=localhost
#   physical device (same Wi-Fi): your LAN IP, e.g. 192.168.1.42
