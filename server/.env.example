# Backend settings. Copy to `server/.env`:  cp server/.env.example server/.env
# Real secrets must never be committed.

# --- PostgreSQL ---
DB_NAME=tappedin
DB_USER=tappedin
DB_PASSWORD=change-me
# Overridden to `postgresql` / `5432` inside docker compose. When running the backend on the host,
# use localhost and the published port of the postgresql container (5433).
DB_HOST=postgresql
DB_PORT=5432
LOCAL_DB_PORT=5433

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
LOCAL_REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=change-me

# --- Optional integrations (leave empty for local MVP work) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_BUCKET_REGION_NAME=

EMAIL_HOSTNAME=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_FROM_EMAIL=
EMAIL_PASSWORD=

MAILCHIMP_API_KEY=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
BREVO_SMS_API_KEY=
